public class Produto {
    private int id;
    private String nome;
    private int quantidade;

    
    public Produto(int id, String nome, int quantidade) {
        this.id = id;
        this.nome = nome;
        this.quantidade = Math.max(quantidade, 0); 
    }

    
    public int getId() {
        return id;
    }

    public String getNome() {
        return nome;
    }

    public int getQuantidade() {
        return quantidade;
    }

   
    public void adicionarEstoque(int qtd) {
        if (qtd > 0) {
            this.quantidade += qtd;
        }
    }

    public boolean removerEstoque(int qtd) {
        if (qtd > 0 && (this.quantidade - qtd) >= 0) {
            this.quantidade -= qtd;
            return true;
        }
        return false; 
    }

    
    @Override
    public String toString() {
        return "ID: " + id + " | Nome: " + nome + " | Qtd: " + quantidade;
    }
}
